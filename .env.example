# Copy to .env and fill in. .env is gitignored; never commit real values.

# MySQL. Format: user:password@tcp(host:port)/database
DB_DSN=root:YOUR_MYSQL_PASSWORD@tcp(localhost:3306)/campus_bites

# Random string, at least 32 chars. Generate one with: openssl rand -hex 32
JWT_SECRET=

# Razorpay dashboard -> Settings -> API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# First admin, created on startup only if the admins table is empty
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional
FRONTEND_ORIGIN=http://localhost:3000
DEFAULT_CANTEEN=main-canteen
ADDR=:8080
