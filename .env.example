# Copy to .env and fill in. .env is gitignored; never commit real values.

# MySQL: user:password@tcp(host:port)/database
DB_DSN=root:YOUR_MYSQL_PASSWORD@tcp(localhost:3306)/campus_bites_dev

# Random string, at least 32 characters. Generate: openssl rand -hex 32
JWT_SECRET=

# First admin, created on startup only if the admins table is empty
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional
FRONTEND_ORIGIN=http://localhost:3000
DEFAULT_CANTEEN=main-canteen
ADDR=:8080

# Razorpay dashboard -> Settings -> API Keys (use test keys while developing)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: enables POST /api/v1/payments/webhook (Razorpay dashboard -> Webhooks). Needs a public URL.
RAZORPAY_WEBHOOK_SECRET=
